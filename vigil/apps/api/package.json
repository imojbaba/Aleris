{
  "name": "@vigil/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "whatsapp:templates": "tsx scripts/print-whatsapp-templates.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@vigil/core": "workspace:*",
    "@vigil/crypto": "workspace:*",
    "@vigil/shared": "workspace:*",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^4.6.5",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "prisma": "^6.19.3"
  }
}
